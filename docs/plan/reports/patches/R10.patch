+
+
+@dataclass(frozen=True)
+class PreparedPlan:
+    """An immutable preview token and the observations it confirms."""
+    plan_id: str
+    link_id: int | None
+    steps: tuple[ApplyStep, ...]
+    snapshots: dict[str, dict]
+    record: dict
+    decision_needed: bool = False
